{
    "name": "scripts/train.py",
    "cmd": "python scripts/train.py",
    "json_schema": {
        "$defs": {
            "InferenceConfig": {
                "properties": {
                    "compile": {
                        "default": false,
                        "title": "Compile",
                        "type": "boolean"
                    },
                    "batch_size": {
                        "default": 1,
                        "title": "Batch Size",
                        "type": "integer"
                    },
                    "threshold": {
                        "default": 0.05,
                        "title": "Threshold",
                        "type": "number"
                    }
                },
                "title": "InferenceConfig",
                "type": "object"
            }
        },
        "properties": {
            "project_name": {
                "default": "Trainer RF-DETR",
                "description": "Project name for the experiment",
                "title": "Project Name",
                "type": "string"
            },
            "model_path": {
                "default": "./pretrained_models/RFDETRNano",
                "description": "Model name or checkpoint path. Options: ['pretrained_models/RFDETRNano', 'pretrained_models/RFDETRMedium', 'pretrained_models/RFDETRLarge', 'pretrained_models/RFDETRSegNano']",
                "title": "Model Path",
                "type": "string"
            },
            "pretrained": {
                "default": true,
                "description": "Use pretrained weights",
                "title": "Pretrained",
                "type": "boolean"
            },
            "epochs": {
                "default": 10,
                "description": "Number of epochs to train",
                "title": "Epochs",
                "type": "integer"
            },
            "batch_size": {
                "default": 8,
                "description": "Batch size for training",
                "title": "Batch Size",
                "type": "integer"
            },
            "grad_accumulation_steps": {
                "default": 1,
                "description": "Gradient accumulation steps",
                "title": "Grad Accumulation Steps",
                "type": "integer"
            },
            "learning_rate": {
                "default": 0.001,
                "description": "Learning rate for optimizer",
                "title": "Learning Rate",
                "type": "number"
            },
            "resolution": {
                "anyOf": [
                    {
                        "type": "integer",
                        "title": "Select 'Integer'"
                    },
                    {
                        "type": "null",
                        "title": "Select None"
                    }
                ],
                "default": null,
                "description": "Input resolution (square side in pixels). Defaults to each model's built-in value.",
                "title": "Resolution"
            },
            "task_name": {
                "anyOf": [
                    {
                        "type": "string",
                        "title": "Select 'String'"
                    },
                    {
                        "type": "null",
                        "title": "Select None"
                    }
                ],
                "default": null,
                "description": "Dataset task name used for training the model. Use only this if the dataset has multiple tasks",
                "title": "Task Name"
            },
            "samples": {
                "anyOf": [
                    {
                        "type": "integer",
                        "title": "Select 'Integer'"
                    },
                    {
                        "type": "null",
                        "title": "Select None"
                    }
                ],
                "default": -1,
                "description": "Number of samples to use for training. Use for testing purposes.",
                "title": "Samples"
            },
            "stop_early": {
                "default": false,
                "description": "Break script before training starts. Can be used to avoid long training times during testing.",
                "title": "Stop Early",
                "type": "boolean"
            },
            "inference_model_name": {
                "default": "checkpoint_best_ema",
                "description": "Inference model name or checkpoint path. Options: ['checkpoint_best_ema', 'checkpoint_best_regular', 'checkpoint_best_total']",
                "title": "Inference Model Name",
                "type": "string"
            },
            "inference_config": {
                "$ref": "#/$defs/InferenceConfig",
                "default": {
                    "compile": true,
                    "batch_size": 1,
                    "threshold": 0.05
                },
                "description": "Inference configuration for the model"
            }
        },
        "title": "mainArgs",
        "type": "object"
    },
    "n_positional_args": 0,
    "case_conversion": "kebab",
    "parameter_prefix": "--",
    "nested_parameter_handling": "dot",
    "assignment_separator": "space",
    "bool_handling": "flag-negation"
}